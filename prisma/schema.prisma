generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GERENTE
  BORRACHARIA
  MANUTENCAO
  VISUALIZACAO
  USER
}

enum TipoManifesto {
  BONIFICACAO_LEBRINHA
  ACERTAR_LEBRINHA
  RECEBER_CLIENTE
}

enum StatusMotorista {
  ATIVO
  DEMITIDO
}

enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
}

enum StatusCiot {
  RASCUNHO
  PRONTO_ENVIO
  PROCESSANDO
  AUTORIZADO
  REJEITADO
  CANCELADO
  ENCERRADO
}

enum TipoOperacaoCiot {
  LOTACAO
  FRACIONADA
  TAC_AGREGADO
}

enum SubcategoriaVeiculo {
  CAMINHAO
  CARRO
  MOTO
}

model User {
  id           String     @id @default(cuid())
  name         String
  username     String     @unique
  email        String     @unique
  telefone     String     @default("")
  cpf          String?    @unique
  fotoPerfil   String?    @db.Text
  passwordHash String
  role         UserRole   @default(VISUALIZACAO)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]

  @@map("users")
}

model Motorista {
  id          String          @id @default(cuid())
  nome        String
  cpf         String
  salarioBase Decimal         @db.Decimal(14, 2)
  status      StatusMotorista @default(ATIVO)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  viagens     Viagem[]
  fechamentos Fechamento[]
  ciots       Ciot[]

  @@index([nome])
  @@map("motoristas")
}

model Chapa {
  id        String   @id @default(cuid())
  nome      String
  telefone  String   @default("")
  cpf       String   @default("")
  cidade    String   @default("")
  chavePix  String   @default("")
  valorFixo Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nome])
  @@index([cpf])
  @@map("chapas")
}

model Cliente {
  id             String          @id @default(cuid())
  nomeFantasia   String
  razaoSocial    String          @default("")
  codigoInterno  String
  cnpj           String          @default("")
  email          String
  telefone       String
  enderecoFiscal String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  manifestos     Manifesto[]
  manifestoProdutos ManifestoProduto[]
  abastecimentos Abastecimento[]
  ciots          Ciot[]

  @@index([nomeFantasia])
  @@index([codigoInterno])
  @@index([cnpj])
  @@map("clientes")
}

model Produto {
  id                   String                 @id @default(cuid())
  nome                 String
  codigoInterno        String
  categoriaEstoque     String                 @default("Produtos de piscina")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  manifestos           ManifestoProduto[]
  abastecimentos       AbastecimentoProduto[]
  movimentacoesEstoque EstoqueMovimentacao[]

  @@index([nome])
  @@index([codigoInterno])
  @@map("produtos")
}

model Local {
  id            String             @id @default(cuid())
  cidade        String
  valorComissao Decimal            @db.Decimal(14, 2)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  fechamentos   FechamentoViagem[]

  @@index([cidade])
  @@map("locais")
}

model Veiculo {
  id                     String           @id @default(cuid())
  placa                  String
  modelo                 String?
  subcategoria           SubcategoriaVeiculo?
  quantidadePneus        Int              @default(10)
  quantidadeEstepes      Int              @default(1)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  abastecimentos         Abastecimento[]
  instalacoesPneus       PneuInstalacao[] @relation("VeiculoInstalacoes")
  instalacoesComoCarreta PneuInstalacao[] @relation("CarretaInstalacoes")
  rodiziosPneus          PneuRodizio[]    @relation("VeiculoRodizios")
  rodiziosComoCarreta    PneuRodizio[]    @relation("CarretaRodizios")
  ciots                  Ciot[]

  @@index([placa])
  @@index([subcategoria])
  @@map("veiculos")
}

model Viagem {
  id                 String    @id @default(cuid())
  placa              String
  motoristaId        String
  valorFrete         Decimal   @db.Decimal(14, 2)
  dataManifesto      DateTime  @db.Date
  cidadeEntrega      String
  distanciaKm        Decimal   @db.Decimal(14, 2)
  valorPedagio       Decimal   @db.Decimal(14, 2)
  valorDiaria        Decimal   @db.Decimal(14, 2)
  valorAbastecimento Decimal   @db.Decimal(14, 2)
  valorChapa         Decimal   @db.Decimal(14, 2)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  motorista          Motorista @relation(fields: [motoristaId], references: [id], onDelete: Restrict)

  @@index([motoristaId])
  @@index([placa])
  @@index([dataManifesto])
  @@map("viagens")
}

model Fechamento {
  id          String             @id @default(cuid())
  motoristaId String
  dataInicio  DateTime           @db.Date
  dataFim     DateTime           @db.Date
  valorTotal  Decimal            @db.Decimal(14, 2)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  motorista   Motorista          @relation(fields: [motoristaId], references: [id], onDelete: Restrict)
  viagens     FechamentoViagem[]

  @@index([motoristaId])
  @@index([dataInicio, dataFim])
  @@map("fechamentos")
}

model FechamentoViagem {
  id           String     @id @default(cuid())
  fechamentoId String
  localId      String
  quantidade   Int
  fechamento   Fechamento @relation(fields: [fechamentoId], references: [id], onDelete: Cascade)
  local        Local      @relation(fields: [localId], references: [id], onDelete: Restrict)

  @@index([fechamentoId])
  @@index([localId])
  @@map("fechamento_viagens")
}

model Manifesto {
  id                    String             @id @default(cuid())
  clienteId             String
  dataManifesto         DateTime           @db.Date
  tipoManifesto         TipoManifesto
  pdfUrl                String?            @db.Text
  transportadoraCodigo  String             @default("")
  transportadoraNome    String             @default("")
  veiculoCodigo         String             @default("")
  placaVeiculo          String             @default("")
  modeloVeiculo         String             @default("")
  romaneios             String             @default("") @db.Text
  notasFiscais          String             @default("") @db.Text
  createdAt             DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  cliente       Cliente            @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  produtos      ManifestoProduto[]

  @@index([clienteId])
  @@index([dataManifesto])
  @@map("manifestos")
}

model ManifestoProduto {
  id            String         @id @default(cuid())
  manifestoId   String
  produtoId     String
  clienteId     String?
  romaneio      String         @default("")
  notaFiscal    String         @default("")
  serieNf       String         @default("")
  instrucaoCobranca String     @default("") @db.Text
  quantidade    Decimal        @db.Decimal(14, 3)
  valorUnitario Decimal        @db.Decimal(14, 2)
  valorTotal    Decimal        @db.Decimal(14, 2)
  tipoManifesto TipoManifesto?
  pagoCliente   Boolean?
  manifesto     Manifesto      @relation(fields: [manifestoId], references: [id], onDelete: Cascade)
  produto       Produto        @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  cliente       Cliente?       @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@index([manifestoId])
  @@index([produtoId])
  @@index([clienteId])
  @@map("manifesto_produtos")
}

model Ciot {
  id                   String           @id @default(cuid())
  idSequencial         Int              @unique @default(autoincrement())
  clienteId            String?
  empresaId            String?
  contratanteRazaoSocial String          @default("")
  contratanteNomeFantasia String         @default("")
  contratanteCnpj       String           @default("")
  contratadoRazaoSocial String           @default("")
  contratadoNomeFantasia String          @default("")
  contratadoCnpj       String           @default("")
  contratadoInscricaoEstadual String     @default("")
  contratadoEndereco   String           @default("") @db.Text
  contratadoCidade     String           @default("")
  contratadoUf         String           @default("")
  motoristaId          String
  veiculoId            String
  tipoOperacao         TipoOperacaoCiot
  status               StatusCiot       @default(RASCUNHO)
  rntrc                String
  origemCidade         String
  origemUf             String
  destinoCidade        String
  destinoUf            String
  dataInicio           DateTime         @db.Date
  dataFim              DateTime?        @db.Date
  naturezaCarga        String
  pesoKg               Decimal          @default(0) @db.Decimal(14, 3)
  valorFrete           Decimal          @default(0) @db.Decimal(14, 2)
  valorPedagio         Decimal          @default(0) @db.Decimal(14, 2)
  outrosValores        Decimal          @default(0) @db.Decimal(14, 2)
  descontos            Decimal          @default(0) @db.Decimal(14, 2)
  valorLiquido         Decimal          @default(0) @db.Decimal(14, 2)
  formaPagamento       String           @default("")
  favorecidoPix        String           @default("")
  payloadAntt          Json?
  preparadoEm          DateTime?
  observacoes          String?          @db.Text
  numeroCiot           String?
  codigoVerificador    String?
  protocolo            String?
  mensagemRetorno      String?          @db.Text
  valorMercadoria      Decimal          @default(0) @db.Decimal(14, 2)
  cnpjsCargaFracionada String           @default("") @db.Text
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  cliente              Cliente?         @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  empresa              Empresa?         @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  motorista            Motorista        @relation(fields: [motoristaId], references: [id], onDelete: Restrict)
  veiculo              Veiculo          @relation(fields: [veiculoId], references: [id], onDelete: Restrict)
  ctes                 CiotCte[]

  @@index([clienteId])
  @@index([empresaId])
  @@index([motoristaId])
  @@index([veiculoId])
  @@index([status])
  @@index([dataInicio])
  @@map("ciots")
}

model CiotCte {
  id               String   @id @default(cuid())
  ciotId           String
  chave            String
  numero           String
  serie            String   @default("")
  emitenteCnpj     String   @default("")
  emitenteNome     String   @default("")
  emitenteNomeFantasia String @default("")
  emitenteInscricaoEstadual String @default("")
  emitenteEndereco String @default("") @db.Text
  emitenteCidade   String @default("")
  emitenteUf       String @default("")
  remetenteCnpj    String   @default("")
  remetenteNome    String   @default("")
  destinatarioCnpj String   @default("")
  destinatarioNome String   @default("")
  tomadorCnpj      String   @default("")
  tomadorNome      String   @default("")
  origemCidade     String   @default("")
  origemUf         String   @default("")
  destinoCidade    String   @default("")
  destinoUf        String   @default("")
  produto          String   @default("")
  ncm              String   @default("")
  pesoKg           Decimal  @default(0) @db.Decimal(14, 3)
  valorMercadoria  Decimal  @default(0) @db.Decimal(14, 2)
  valorFrete       Decimal  @default(0) @db.Decimal(14, 2)
  valorPedagio      Decimal  @default(0) @db.Decimal(14, 2)
  xmlUrl           String?  @db.Text
  arquivoNome      String   @default("")
  dataEmissao      DateTime? @db.Date
  createdAt        DateTime @default(now())
  ciot             Ciot     @relation(fields: [ciotId], references: [id], onDelete: Cascade)

  @@unique([ciotId, chave])
  @@index([ciotId])
  @@index([chave])
  @@map("ciot_ctes")
}

model Abastecimento {
  id                        String                 @id @default(cuid())
  clienteId                 String
  veiculoId                 String
  chaveNfe                  String?                @unique
  numeroNfe                 String                 @default("")
  serieNfe                  String                 @default("")
  emitenteCnpj              String                 @default("")
  emitenteRazaoSocial       String                 @default("")
  emitenteNomeFantasia      String                 @default("")
  emitenteInscricaoEstadual String                 @default("")
  emitenteEndereco          String                 @default("") @db.Text
  emitenteCidade            String                 @default("")
  emitenteUf                String                 @default("")
  destinatarioCnpjCpf       String                 @default("")
  destinatarioRazaoSocial   String                 @default("")
  destinatarioEndereco      String                 @default("") @db.Text
  destinatarioCidade        String                 @default("")
  destinatarioUf            String                 @default("")
  naturezaOperacao          String                 @default("")
  placaXml                  String                 @default("")
  hodometroOrigem           String                 @default("") @db.Text
  valorProdutos             Decimal                @default(0) @db.Decimal(14, 2)
  valorFrete                Decimal                @default(0) @db.Decimal(14, 2)
  valorSeguro               Decimal                @default(0) @db.Decimal(14, 2)
  valorOutros               Decimal                @default(0) @db.Decimal(14, 2)
  valorIcms                 Decimal                @default(0) @db.Decimal(14, 2)
  valorPis                  Decimal                @default(0) @db.Decimal(14, 2)
  valorCofins               Decimal                @default(0) @db.Decimal(14, 2)
  informacoesComplementares String                 @default("") @db.Text
  dataEmissao               DateTime               @db.Date
  valorDesconto             Decimal                @default(0) @db.Decimal(14, 2)
  valorTotal                Decimal                @db.Decimal(14, 2)
  hodometro                 Decimal                @db.Decimal(14, 1)
  pdfUrl                    String?                @db.Text
  xmlUrl                    String?                @db.Text
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  cliente                   Cliente                @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  veiculo                   Veiculo                @relation(fields: [veiculoId], references: [id], onDelete: Restrict)
  produtos                  AbastecimentoProduto[]

  @@index([clienteId])
  @@index([veiculoId])
  @@index([dataEmissao])
  @@index([emitenteCnpj])
  @@map("abastecimentos")
}

model AbastecimentoProduto {
  id               String        @id @default(cuid())
  abastecimentoId  String
  produtoId        String
  quantidadeLitros Decimal       @db.Decimal(14, 3)
  valorUnitario    Decimal       @db.Decimal(14, 4)
  valorTotal       Decimal       @db.Decimal(14, 2)
  abastecimento    Abastecimento @relation(fields: [abastecimentoId], references: [id], onDelete: Cascade)
  produto          Produto       @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([abastecimentoId])
  @@index([produtoId])
  @@map("abastecimento_produtos")
}

enum StatusPneu {
  ESTOQUE
  INSTALADO
  MANUTENCAO
  RECAPAGEM
  DESCARTADO
}

enum TipoPneu {
  DIRECIONAL
  TRACAO
  LIVRE
}

enum CondicaoPneu {
  NOVO
  USADO
  RECAPADO
  AGUARDANDO_RECAPAGEM
}

enum TipoEventoPneu {
  COMPRA
  ALTERACAO
  STATUS
  FOTO
  INSTALACAO
  RETIRADA
  RODIZIO
  SULCO
  CALIBRAGEM
  RECAPAGEM
  CONSERTO
  INSPECAO
}

model EstoqueMovimentacao {
  id            String                  @id @default(cuid())
  produtoId     String
  tipo          TipoMovimentacaoEstoque
  quantidade    Decimal                 @db.Decimal(14, 3)
  valorUnitario Decimal                 @default(0) @db.Decimal(14, 2)
  valorTotal    Decimal                 @default(0) @db.Decimal(14, 2)
  data          DateTime                @db.Date
  observacoes   String?
  pdfUrl        String?                 @db.Text
  pdfName       String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  produto       Produto                 @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([produtoId])
  @@index([tipo])
  @@index([data])
  @@map("estoque_movimentacoes")
}

model Pneu {
  id                   String                 @id @default(cuid())
  numeroFogo           String                 @unique
  codigoBarras         String?
  qrCode               String?
  marca                String
  modelo               String
  medida               String
  dot                  String
  numeroSerie          String?
  tipo                 TipoPneu
  valorCompra          Decimal                @db.Decimal(14, 2)
  fornecedor           String
  dataCompra           DateTime               @db.Date
  maxRecapagens        Int                    @default(0)
  recapagensRealizadas Int                    @default(0)
  status               StatusPneu             @default(ESTOQUE)
  condicao             CondicaoPneu           @default(NOVO)
  sulcoInicial         Decimal?               @db.Decimal(6, 2)
  sulcoAtual           Decimal?               @db.Decimal(6, 2)
  kmAtual              Decimal                @default(0) @db.Decimal(14, 1)
  proximoRodizioKm     Decimal?               @db.Decimal(14, 1)
  observacoes          String?                @db.Text
  deletedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  fotos                PneuFoto[]
  eventos              PneuEvento[]
  instalacoes          PneuInstalacao[]
  rodizioMovimentos    PneuRodizioMovimento[]
  medicoesSulco        PneuMedicaoSulco[]
  calibragens          PneuCalibragem[]
  recapagens           PneuRecapagem[]
  consertos            PneuConserto[]
  inspecoes            PneuInspecao[]

  @@index([status])
  @@index([condicao])
  @@index([marca])
  @@index([dataCompra])
  @@map("pneus")
}

model PneuFoto {
  id        String   @id @default(cuid())
  pneuId    String
  url       String   @db.Text
  legenda   String?
  createdAt DateTime @default(now())
  pneu      Pneu     @relation(fields: [pneuId], references: [id], onDelete: Cascade)

  @@index([pneuId])
  @@map("pneu_fotos")
}

model PneuEvento {
  id            String         @id @default(cuid())
  pneuId        String
  tipo          TipoEventoPneu
  data          DateTime       @default(now())
  quilometragem Decimal?       @db.Decimal(14, 1)
  responsavel   String?
  observacoes   String?        @db.Text
  dados         Json?
  createdAt     DateTime       @default(now())
  pneu          Pneu           @relation(fields: [pneuId], references: [id], onDelete: Cascade)

  @@index([pneuId])
  @@index([data])
  @@map("pneu_eventos")
}

model PneuInstalacao {
  id             String      @id @default(cuid())
  pneuId         String
  veiculoId      String
  carretaId      String?
  eixo           String
  posicao        String
  dataInstalacao DateTime    @db.Date
  kmInstalacao   Decimal     @db.Decimal(14, 1)
  responsavel    String
  dataRetirada   DateTime?   @db.Date
  kmRetirada     Decimal?    @db.Decimal(14, 1)
  motivoRetirada String?     @db.Text
  statusDestino  StatusPneu?
  ativo          Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  pneu           Pneu        @relation(fields: [pneuId], references: [id], onDelete: Restrict)
  veiculo        Veiculo     @relation("VeiculoInstalacoes", fields: [veiculoId], references: [id], onDelete: Restrict)
  carreta        Veiculo?    @relation("CarretaInstalacoes", fields: [carretaId], references: [id], onDelete: Restrict)

  @@index([pneuId, ativo])
  @@index([veiculoId, ativo])
  @@index([carretaId, ativo])
  @@index([eixo, posicao])
  @@map("pneu_instalacoes")
}

model PneuRodizio {
  id            String                 @id @default(cuid())
  veiculoId     String
  carretaId     String?
  data          DateTime               @db.Date
  quilometragem Decimal                @db.Decimal(14, 1)
  responsavel   String
  motivo        String                 @db.Text
  createdAt     DateTime               @default(now())
  veiculo       Veiculo                @relation("VeiculoRodizios", fields: [veiculoId], references: [id], onDelete: Restrict)
  carreta       Veiculo?               @relation("CarretaRodizios", fields: [carretaId], references: [id], onDelete: Restrict)
  movimentos    PneuRodizioMovimento[]

  @@index([veiculoId, data])
  @@index([carretaId, data])
  @@map("pneu_rodizios")
}

model PneuRodizioMovimento {
  id             String      @id @default(cuid())
  rodizioId      String
  pneuId         String
  eixoOrigem     String
  posicaoOrigem  String
  eixoDestino    String
  posicaoDestino String
  rodizio        PneuRodizio @relation(fields: [rodizioId], references: [id], onDelete: Cascade)
  pneu           Pneu        @relation(fields: [pneuId], references: [id], onDelete: Restrict)

  @@index([rodizioId])
  @@index([pneuId])
  @@map("pneu_rodizio_movimentos")
}

model PneuMedicaoSulco {
  id                 String   @id @default(cuid())
  pneuId             String
  data               DateTime @db.Date
  quilometragem      Decimal? @db.Decimal(14, 1)
  sulcoInterno       Decimal  @db.Decimal(6, 2)
  sulcoCentral       Decimal  @db.Decimal(6, 2)
  sulcoExterno       Decimal  @db.Decimal(6, 2)
  mediaSulco         Decimal  @db.Decimal(6, 2)
  percentualDesgaste Decimal  @db.Decimal(6, 2)
  vidaUtilRestante   Decimal  @db.Decimal(6, 2)
  responsavel        String
  observacoes        String?  @db.Text
  createdAt          DateTime @default(now())
  pneu               Pneu     @relation(fields: [pneuId], references: [id], onDelete: Cascade)

  @@index([pneuId, data])
  @@map("pneu_medicoes_sulco")
}

model PneuCalibragem {
  id                 String   @id @default(cuid())
  pneuId             String
  data               DateTime @db.Date
  pressaoRecomendada Decimal  @db.Decimal(8, 2)
  pressaoEncontrada  Decimal  @db.Decimal(8, 2)
  pressaoAjustada    Decimal  @db.Decimal(8, 2)
  responsavel        String
  observacoes        String?  @db.Text
  createdAt          DateTime @default(now())
  pneu               Pneu     @relation(fields: [pneuId], references: [id], onDelete: Cascade)

  @@index([pneuId, data])
  @@map("pneu_calibragens")
}

model PneuRecapagem {
  id                String    @id @default(cuid())
  pneuId            String
  empresaRecapadora String
  dataEnvio         DateTime  @db.Date
  dataRetorno       DateTime? @db.Date
  valor             Decimal   @db.Decimal(14, 2)
  garantiaMeses     Int       @default(0)
  tipoRecapagem     String
  numeroRecapagem   Int
  observacoes       String?   @db.Text
  createdAt         DateTime  @default(now())
  pneu              Pneu      @relation(fields: [pneuId], references: [id], onDelete: Cascade)

  @@unique([pneuId, numeroRecapagem])
  @@index([pneuId, dataEnvio])
  @@map("pneu_recapagens")
}

model PneuConserto {
  id          String   @id @default(cuid())
  pneuId      String
  tipo        String
  data        DateTime @db.Date
  valor       Decimal  @db.Decimal(14, 2)
  responsavel String
  observacoes String?  @db.Text
  fotosAntes  Json?
  fotosDepois Json?
  createdAt   DateTime @default(now())
  pneu        Pneu     @relation(fields: [pneuId], references: [id], onDelete: Cascade)

  @@index([pneuId, data])
  @@map("pneu_consertos")
}

model PneuInspecao {
  id                String   @id @default(cuid())
  pneuId            String
  data              DateTime @db.Date
  responsavel       String
  pressaoOk         Boolean
  sulcoOk           Boolean
  cortes            Boolean  @default(false)
  bolhas            Boolean  @default(false)
  trincas           Boolean  @default(false)
  desgasteIrregular Boolean  @default(false)
  lonaAparente      Boolean  @default(false)
  observacoes       String?  @db.Text
  fotos             Json?
  createdAt         DateTime @default(now())
  pneu              Pneu     @relation(fields: [pneuId], references: [id], onDelete: Cascade)

  @@index([pneuId, data])
  @@map("pneu_inspecoes")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  method    String
  path      String
  entityId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Empresa {
  id                  String    @id @default(cuid())
  razaoSocial         String
  nomeFantasia        String?   @default("")
  cnpj                String    @unique
  inscricaoEstadual   String?   @default("")
  rntrc               String?   @default("")
  antt                String?   @default("")
  email               String?   @default("")
  telefone            String?   @default("")
  cep                 String?   @default("")
  logradouro          String?   @default("")
  numero              String?   @default("")
  complemento         String?   @default("")
  bairro              String?   @default("")
  cidade              String?   @default("")
  uf                  String?   @default("")
  certificadoArquivo  String?   @default("") @db.Text
  certificadoSenha    String?   @default("") @db.Text
  certificadoValidade DateTime?
  ativa               Boolean   @default(true)
  empresaPadrao       Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  ciots               Ciot[]

  @@index([cnpj])
  @@index([empresaPadrao])
  @@map("empresas")
}

model Pedagio {
  id              String   @id @default(cuid())
  nome            String
  rodovia         String   @default("")
  km              String   @default("")
  cidade          String   @default("")
  uf              String   @default("")
  concessionaria  String   @default("")
  latitude        Decimal  @db.Decimal(10, 7)
  longitude       Decimal  @db.Decimal(10, 7)
  raioKm          Decimal  @default(1.5) @db.Decimal(6, 2)
  valorPorEixo    Decimal  @db.Decimal(12, 2)
  ativo           Boolean  @default(true)
  fonte           String   @default("MANUAL")
  observacoes     String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ativo])
  @@index([uf])
  @@index([rodovia])
  @@map("pedagios")
}
