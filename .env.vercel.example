# Banco Neon - use a connection string pooled (-pooler) no runtime da Vercel.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=require"

# Aplicação
NODE_ENV="production"
CLIENT_ORIGIN="https://radasa.com.br,https://www.radasa.com.br"
LOG_LEVEL="info"

# Autenticação - gere um segredo forte e não versione o valor real.
JWT_SECRET="gere-um-segredo-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="8h"
AUTH_REQUIRED="true"

# CIOT/ANTT (mantenha homologação até concluir a configuração de produção)
ANTT_CIOT_ENVIRONMENT="homologacao"
ANTT_CIOT_ENABLE_NETWORK="false"
